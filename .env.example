# ─────────────────────────────────────────────────────────────────────────────
# FLIP AI – variabili d'ambiente (copia in .env.local per lo sviluppo locale)
# NON inserire mai valori reali in questo file e non committare .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# URL pubblico dell'app (usato nei link email di conferma/reset password)
NEXT_PUBLIC_APP_URL=https://www.tuodominio.it

# Supabase → Project Settings → API
# Se lasciate vuote l'app parte in "modalità demo locale" (dati nel browser).
# ATTENZIONE: le variabili NEXT_PUBLIC_* vengono incorporate durante la BUILD.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave segreta (service_role / secret key): SOLO server-side.
# Serve solo per script amministrativi (npm run seed:demo). Mai nel frontend.
SUPABASE_SERVICE_ROLE_KEY=

# AI (opzionale). Senza chiave l'app usa il motore AI locale (mock) e funziona comunque.
# Provider supportato: anthropic (Claude). La chiave resta solo sul server.
AI_PROVIDER=anthropic
AI_API_KEY=
# Modello (default: claude-opus-5-5)
AI_MODEL=
# Limite richieste AI per utente al minuto
AI_RATE_LIMIT_PER_MINUTE=15

# Solo per lo script seed:demo (facoltativo)
DEMO_EMAIL=
DEMO_PASSWORD=
