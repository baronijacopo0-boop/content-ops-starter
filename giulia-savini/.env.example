# URL pubblico del sito (senza slash finale). Usato per canonical, sitemap e OpenGraph.
# Su Netlify, se vuoto, viene usata automaticamente la variabile URL.
NEXT_PUBLIC_SITE_URL=

# Numero WhatsApp professionale in formato internazionale, solo cifre (es. 39XXXXXXXXXX).
# Se vuoto, il pulsante WhatsApp non viene mostrato.
WHATSAPP_NUMBER=

# Invio email del form contatti tramite Resend (https://resend.com).
RESEND_API_KEY=
# Indirizzo che riceve le richieste
CONTACT_TO_EMAIL=
# Mittente verificato su Resend (es. "Sito Giulia Savini <noreply@dominio.it>")
CONTACT_FROM_EMAIL=

# Solo per demo: se "true" il form simula un invio riuscito quando l'email non è configurata.
CONTACT_FORM_DEMO=

# Prenotazione online collegata a Google Calendar (account di servizio, vedi README).
# Con tutte e tre valorizzate e bookingConfig.hoursConfirmed = true le prenotazioni sono reali.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chiave privata dell'account di servizio (dal file JSON, campo private_key). I "\n" sono accettati.
GOOGLE_PRIVATE_KEY=
# ID del calendario della Dott.ssa (di solito il suo indirizzo Gmail)
GOOGLE_CALENDAR_ID=

# Solo per la demo: se "true" mostra cornici con le indicazioni al posto delle foto mancanti
# e il calendario con orari di esempio (prenotazioni simulate) finché Google non è collegato. Da rimuovere al lancio.
SHOW_DEMO_PLACEHOLDERS=
